function editYumeNote(){if(!requireAdminMode())return;const n=yumeData().notes[yumeNoteIndex];if(!n)return;const title=prompt('筆記標題',n.title||'');if(title===null)return;const content=prompt('筆記內文',n.text||'');if(content===null)return;n.title=title;n.text=content;saveAppData();renderYumeNote();}
function deleteYumeNote(){if(!requireAdminMode())return;const notes=yumeData().notes;if(notes.length&&confirm('確定刪除這一頁？')){notes.splice(yumeNoteIndex,1);saveAppData();renderYumeNote();}}
document.addEventListener('DOMContentLoaded',()=>{renderYume();setInterval(yumeTime,1000);});
</script>

<script>
/* 以 Canvas 產生銀河背景：不依賴外部圖片網址 */
(function(){
 const canvas=document.getElementById('galaxy-sky');if(!canvas)return;
 const ctx=canvas.getContext('2d');if(!ctx)return;
 let seed=20261106;const rand=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296};
 function draw(){seed=20261106;const dpr=Math.min(devicePixelRatio||1,2),w=innerWidth,h=innerHeight;canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,w,h);
 let nebula=ctx.createRadialGradient(w*.58,h*.24,10,w*.58,h*.24,Math.max(w*.75,h*.65));nebula.addColorStop(0,'rgba(111,82,180,.17)');nebula.addColorStop(.5,'rgba(69,57,133,.1)');nebula.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=nebula;ctx.fillRect(0,0,w,h);
 ctx.save();ctx.translate(w*.5,h*.28);ctx.rotate(-.27);
 for(let i=0;i<440;i++){const x=(rand()-.5)*w*1.9,y=(rand()-.5)*Math.min(h*.43,390),r=1+rand()*28;const g=ctx.createRadialGradient(x,y,0,x,y,r);const c=rand()>.6?'164,139,245':'105,132,219';g.addColorStop(0,'rgba('+c+','+(0.015+rand()*.055)+')');g.addColorStop(1,'rgba('+c+',0)');ctx.fillStyle=g;ctx.fillRect(x-r,y-r,r*2,r*2)}ctx.restore();
 for(let i=0;i<Math.min(600,Math.round(w*h/1800));i++){let x=rand()*w,y=rand()*h,r=.25+rand()*1.25;ctx.fillStyle=rand()>.8?'rgba(247,220,168,.7)':'rgba(225,222,255,.65)';ctx.globalAlpha=.2+rand()*.8;ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fill();}ctx.globalAlpha=1;
 for(let i=0;i<18;i++){const x=rand()*w,y=rand()*h,r=1+rand()*1.3;ctx.strokeStyle='rgba(245,221,171,.38)';ctx.lineWidth=.6;ctx.beginPath();ctx.moveTo(x-r*4,y);ctx.lineTo(x+r*4,y);ctx.moveTo(x,y-r*4);ctx.lineTo(x,y+r*4);ctx.stroke();}
 }draw();let t;addEventListener('resize',()=>{clearTimeout(t);t=setTimeout(draw,180)},{passive:true});
})();
</script>

