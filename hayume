async function storeDreamAudio(blob){const db=await openDreamAudioDB();return new Promise((resolve,reject)=>{const tx=db.transaction('tracks','readwrite');tx.objectStore('tracks').put(blob,DREAM_AUDIO_KEY);tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);});}
async function getDreamAudio(){try{const db=await openDreamAudioDB();return await new Promise((resolve,reject)=>{const tx=db.transaction('tracks','readonly');const req=tx.objectStore('tracks').get(DREAM_AUDIO_KEY);req.onsuccess=()=>resolve(req.result||null);req.onerror=()=>reject(req.error);});}catch(e){return null;}}
