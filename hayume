                if (existing && previous) Object.assign(existing, previous);
                else appData.characters = appData.characters.filter(c => String(c.id) !== String(newCharacterId));
                alert('儲存失敗，瀏覽器容量已滿。請匯出備份 JSON 並清理部分資料。');
                return;
            }
            renderCharacters();
            renderProfile();
            if (wasEditing) {
                const updated = appData.characters.find(c => String(c.id) === String(currentEditingCharacterId));
