async function attachDreamAudio(blob){const audio=document.getElementById('dream-audio');if(!audio||!blob)return;if(dreamAudioObjectUrl)URL.revokeObjectURL(dreamAudioObjectUrl);dreamAudioObjectUrl=URL.createObjectURL(blob);audio.src=dreamAudioObjectUrl;audio.load();}
async function toggleDreamMusic(){const audio=document.getElementById('dream-audio');if(!audio)return;if(!audio.src){const blob=await getDreamAudio();if(blob){await attachDreamAudio(blob);const status=document.getElementById('music-status');if(status)status.textContent='已載入背景音樂';}else{alert('尚未選擇背景音樂。請先在「自我介紹」頁面選擇音樂檔。');return;}}const icon=document.getElementById('music-toggle-icon');if(audio.paused){try{await audio.play();if(icon)icon.className='fa-solid fa-volume-high';}catch(e){alert('瀏覽器尚未允許播放，請再點擊一次播放按鈕。');}}else{audio.pause();if(icon)icon.className='fa-solid fa-volume-xmark';}}
async function clearDreamMusic(){if(!requireAdminMode())return;const db=await openDreamAudioDB();await new Promise((resolve,reject)=>{const tx=db.transaction('tracks','readwrite');tx.objectStore('tracks').delete(DREAM_AUDIO_KEY);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error);});const audio=document.getElementById('dream-audio');audio.pause();audio.removeAttribute('src');audio.load();if(dreamAudioObjectUrl)URL.revokeObjectURL(dreamAudioObjectUrl);dreamAudioObjectUrl=null;const status=document.getElementById('music-status');if(status)status.textContent='尚未選擇音樂';const icon=document.getElementById('music-toggle-icon');if(icon)icon.className='fa-solid fa-volume-xmark';}
document.addEventListener('DOMContentLoaded',async()=>{const blob=await getDreamAudio();if(blob){await attachDreamAudio(blob);const status=document.getElementById('music-status');if(status)status.textContent='已儲存背景音樂';// attempt autoplay; browsers may require a user gesture
try{await document.getElementById('dream-audio').play();const icon=document.getElementById('music-toggle-icon');if(icon)icon.className='fa-solid fa-volume-high';}catch(e){/* expected autoplay restriction */}}
});
</script>

