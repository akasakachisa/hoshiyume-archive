<script>
// ===== Dream Archive + music controls (keeps original OC data untouched) =====
const DREAM_START_KEY = 'hoshiyume_dream_start_date';
const DREAM_AUDIO_DB = 'hoshiyume_audio_store';
const DREAM_AUDIO_KEY = 'background_track';
let dreamAudioObjectUrl = null;
function getDreamStartDate(){ return localStorage.getItem(DREAM_START_KEY) || '2026-10-18'; }
function updateDreamCounter(){
  const startStr=getDreamStartDate();
  const match=/^(\d{4})-(\d{2})-(\d{2})$/.exec(startStr);
  if(!match)return;
  const sy=Number(match[1]),sm=Number(match[2]),sd=Number(match[3]);
  const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Taipei',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());
  const d=Object.fromEntries(parts.filter(x=>x.type!=='literal').map(x=>[x.type,Number(x.value)]));
  const today=Date.UTC(d.year,d.month-1,d.day), start=Date.UTC(sy,sm-1,sd);
  const total=Math.max(0,Math.floor((today-start)/86400000));
  let y=0,m=0,days=0;
  if(today>=start){
    y=d.year-sy;m=d.month-sm;days=d.day-sd;
    if(days<0){m--;days+=new Date(Date.UTC(d.year,d.month-1,0)).getUTCDate();}
    if(m<0){y--;m+=12;}
  }
  const put=(id,val)=>{const el=document.getElementById(id);if(el)el.textContent=String(val).padStart(2,'0');};
  put('dream-years',y);put('dream-months',m);put('dream-days',days);put('dream-total-days',total);
  const label=document.getElementById('dream-start-label');if(label)label.textContent=`${sy} 年 ${String(sm).padStart(2,'0')} 月 ${String(sd).padStart(2,'0')} 日`;
  const input=document.getElementById('dream-date-input');if(input)input.value=startStr;
}
function saveDreamStartDate(){if(!requireAdminMode())return;const v=document.getElementById('dream-date-input')?.value;if(!v)return;localStorage.setItem(DREAM_START_KEY,v);updateDreamCounter();alert('紀念起始日期已更新。');}
