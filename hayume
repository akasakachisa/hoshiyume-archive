        // --- IMAGE COMPRESSION HELPER (Solves "file too large" error) ---
        // 圖片自動縮放、WebP/JPEG 壓縮及大小限制；所有既有上傳入口共用。
        function compressImageFile(file, maxWidth = 800, quality = 0.8) {
            return new Promise((resolve, reject) => {
                if (!file) return resolve('');
                if (!file.type.startsWith('image/')) return reject(new Error('請選擇圖片檔案。'));
                const url = URL.createObjectURL(file);
                const img = new Image();
                img.onload = () => {
                    URL.revokeObjectURL(url);
                    try {
                        let w=img.naturalWidth, h=img.naturalHeight;
                        const limit=Math.min(maxWidth, 1600);
                        const scale=Math.min(1,limit/Math.max(w,h));
                        w=Math.max(1,Math.round(w*scale));h=Math.max(1,Math.round(h*scale));
                        const canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;
                        const ctx=canvas.getContext('2d');if(!ctx)throw Error('無法建立圖片壓縮器');
                        ctx.drawImage(img,0,0,w,h);
                        const format='image/webp';let result='';
                        for(const q of [Math.min(quality,.8),.66,.52,.4]) {
                            result=canvas.toDataURL(format,q);
                            if(!result.startsWith('data:image/webp'))result=canvas.toDataURL('image/jpeg',q);
                            if(result.length<=450000)break;
                        }
                        // 超過約 330KB 時繼續縮小，避免大量 base64 圖片塞滿 localStorage。
                        for(let i=0;result.length>450000&&i<5;i++){
                            const nw=Math.max(1,Math.round(canvas.width*.8)),nh=Math.max(1,Math.round(canvas.height*.8));
                            const next=document.createElement('canvas');next.width=nw;next.height=nh;
                            next.getContext('2d').drawImage(canvas,0,0,nw,nh);
                            canvas.width=nw;canvas.height=nh;ctx.drawImage(next,0,0,nw,nh);
                            result=canvas.toDataURL(format,.52);
                            if(!result.startsWith('data:image/webp'))result=canvas.toDataURL('image/jpeg',.52);
                        }
                        resolve(result);
                    }catch(e){reject(e);}
                };
                img.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('圖片解析失敗'));};
                img.src=url;
            });
        }

