                button.classList.toggle('text-emerald-200', active);
                button.classList.toggle('border-emerald-700', active);
            }
        }
        function classifyAdminControls(root) {
            const candidates = root.querySelectorAll ? Array.from(root.querySelectorAll('button, input[type="submit"], input[type="file"]')) : [];
            if (root.matches && root.matches('button, input[type="submit"], input[type="file"]')) candidates.push(root);
        const adminAction = /openEdit|openAdd|save|delete|remove|addInterest|addBoundary|editCurrent|deleteCurrent|editLore|deleteLore|addMapPin|clearMapImage|changeMapImage|triggerImport|importData|exportData|exportFullWebsite|openEditCharacter|openAddCharacter|openAddEvent|openAddBook|openAddChapter|addEvent|addLore|upload|change/i;
            const mutationWords = /編輯|刪除|移除|新增|建立|儲存|上傳|更換|匯入|匯出|清除|管理員/i;
            candidates.forEach(el => {
                if (el.id === 'admin-mode-button' || el.closest('nav') || /^((desktop|mobile)-)?tab-btn-/.test(el.id || '')) return;
                const handler = el.getAttribute('onclick') || el.getAttribute('onchange') || '';
