            'openAddBookModal', 'editCurrentBook', 'deleteCurrentBook', 'openAddChapterModal', 'editCurrentChapter', 'deleteCurrentChapter',
            'openAddEventModal', 'deleteEvent', 'openAddLoreModal', 'editLore', 'deleteLore', 'addMapPin', 'editMapPin', 'deleteMapPin', 'clearMapImage', 'changeMapImage', 'triggerImport', 'importData', 'exportData','exportFullWebsite',
        ]);

        // Data Backup Export & Import Logic
        // Exports a portable single-file website with the current appData embedded (including image data URLs).
        async function exportFullWebsite() {
            let publicData;
            try { publicData=await makePublicSnapshot(); }catch(err){alert('網站匯出失敗：'+err.message);return;}
            // Export the live DOM and inject a snapshot into <head>, before startup scripts run.
            const clone = document.documentElement.cloneNode(true);
            clone.querySelectorAll('[data-archive-snapshot]').forEach(node => node.remove());
            // Images are loaded from the embedded snapshot at startup.
            clone.querySelectorAll('img').forEach(img => {img.removeAttribute('src');img.removeAttribute('srcset');});
            clone.querySelectorAll('[style]').forEach(el => {if(/url\s*\(/i.test(el.getAttribute('style')||''))el.removeAttribute('style');});
            clone.querySelectorAll('input[type="url"]').forEach(el => {el.removeAttribute('value');});
            const snapshot = document.createElement('script');
            snapshot.setAttribute('data-archive-snapshot', '');
            snapshot.textContent = 'window.__OC_PORTABLE_DATA__ = ' + JSON.stringify(publicData).replace(/</g, '\\u003c') + ';';
            clone.querySelector('head').insertBefore(snapshot, clone.querySelector('head').firstChild);
            const portable = '<!DOCTYPE html>\n' + clone.outerHTML;
            const blob = new Blob([portable], {type:'text/html;charset=utf-8'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url;
            a.download = `星夢を紡ぐ羽_完整網站_${new Date().toISOString().slice(0,10)}.html`;
            document.body.appendChild(a); a.click(); a.remove();
            setTimeout(() => URL.revokeObjectURL(url), 1500);
